{
  "name": "makak",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "makak": "./src/cli/makak.ts"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#server/*": "./src/server/*"
  },
  "scripts": {
    "dev": "node src/cli/makak.ts start --dev",
    "build": "vite build",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "ultracite check && prettier --check \"**/*.svelte\"",
    "fix": "ultracite fix && prettier --write \"**/*.svelte\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node src/cli/makak.ts start"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^22",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "ultracite": "8.0.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.14.0"
}
